# Environment variables for the Spring Boot backend.
#
# IMPORTANT: Spring Boot does NOT automatically read a ".env" file. This
# file only documents the variable names and safe example values — see
# README.md "Local Development Setup" (Step 3) for the two supported ways
# to actually supply them: editing application.yml directly, or exporting
# these as real OS environment variables before running the app.
#
# DO NOT put real credentials in this file, and never commit a version of
# it that contains real values.

# --- Database: pick ONE of the two options below ---

# Option A: a single full JDBC URL
DB_URL=jdbc:mysql://YOUR_DATABASE_HOST:3306/YOUR_DATABASE_NAME?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Option B: separate host/port/name (used only if DB_URL is not set)
DB_HOST=YOUR_DATABASE_HOST
DB_PORT=3306
DB_NAME=YOUR_DATABASE_NAME

# Required either way:
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# --- JWT ---
JWT_SECRET=YOUR_JWT_SECRET
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# --- Server & CORS ---
SERVER_PORT=5000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Seed data ---
SEED_ENABLED=true
