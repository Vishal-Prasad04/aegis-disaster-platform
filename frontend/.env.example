# Base URL for the Spring Boot backend API (see /backend). Point this at
# your deployed backend's origin + /api in production — never hardcode a
# production URL in source. Local default matches the backend's defaults.
VITE_API_URL=http://localhost:5000/api

# Set to "true" to force every src/api/*.js module to use its bundled mock
# data instead of calling the real backend — useful for frontend-only dev
# or demos with no backend running. Leave "false" (or unset) to use the
# live API, which is the correct setting for staging/production builds.
VITE_USE_MOCKS=false
